{
  "name": "engineering-harness",
  "private": true,
  "version": "0.2.0",
  "files": ["apps/cli", "apps/server", "apps/web/dist", "packages", "skills", "workflows", "docs", "examples"],
  "type": "module",
  "bin": {
    "eng": "apps/cli/bin/eng.mjs"
  },
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "eng": "node apps/cli/src/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "node apps/web/build.mjs",
    "serve": "node apps/cli/bin/eng.mjs serve",
    "format": "prettier --write apps packages tests examples",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.10",
    "playwright-core": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  }
}
